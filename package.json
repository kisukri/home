{
  "name": "home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Alue 的个人主页",
  "author": "Alue",
  "license": "MIT",
  "homepage": "https://ialue.com",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test -c tests/e2e",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/crimson-pro": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.101",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
